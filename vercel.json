{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/cinemaos/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=:cinemaOsPath*"
    },
    {
      "source": "/_next/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=_next/:cinemaOsPath*"
    },
    {
      "source": "/api/cinemaosv2/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=api/cinemaosv2/:cinemaOsPath*"
    },
    {
      "source": "/api/moviebox/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=api/moviebox/:cinemaOsPath*"
    },
    {
      "source": "/api/multi-movies/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=api/multi-movies/:cinemaOsPath*"
    },
    {
      "source": "/api/tmdb/:cinemaOsPath*",
      "destination": "/api/cinemaos-proxy?upstreamPath=api/tmdb/:cinemaOsPath*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
